PORT=4000
NODE_ENV=development

# PostgreSQL Database — change these to your actual database credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vbills
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Secrets — use long random strings in production!
JWT_SECRET=vbills_jwt_secret_change_this_in_production_use_64chars
JWT_REFRESH_SECRET=vbills_refresh_secret_change_this_in_production_use_64chars

# Your frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Supabase (needed only for one-time data migration)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
